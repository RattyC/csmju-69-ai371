---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResultSummary from '../components/ResultSummary.astro';
import WeaknessChart from '../components/WeaknessChart.astro';
---

<BaseLayout title="สรุปผล">
  <div id="empty" hidden class="card mx-auto max-w-lg p-8 text-center">
    <h1 class="text-xl font-semibold">ยังไม่มีผลการทำข้อสอบ</h1>
    <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">เริ่มฝึกหรือทำข้อสอบจำลองก่อน แล้วผลจะแสดงที่นี่</p>
    <div class="mt-6 flex justify-center gap-2"><a href="/practice/" class="btn-secondary">ฝึก</a><a href="/exam/" class="btn-primary">สอบ</a></div>
  </div>

  <div id="content" hidden class="space-y-6">
    <p data-auto hidden class="rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-200">หมดเวลา — ระบบส่งข้อสอบให้อัตโนมัติ</p>

    <ResultSummary />

    <div class="grid gap-4 sm:grid-cols-2">
      <section class="card p-6" aria-labelledby="strong-heading">
        <h2 id="strong-heading" class="flex items-center gap-2 font-semibold"><span class="size-2.5 rounded-full bg-emerald-600"></span>จุดแข็ง <span class="text-xs font-normal text-zinc-500 dark:text-zinc-400">หมวดที่ได้ ≥ 80%</span></h2>
        <ul data-strong class="mt-3 space-y-1.5 text-sm"></ul>
      </section>
      <section class="card p-6" aria-labelledby="weak-heading">
        <h2 id="weak-heading" class="flex items-center gap-2 font-semibold"><span class="size-2.5 rounded-full bg-rose-600"></span>จุดอ่อน <span class="text-xs font-normal text-zinc-500 dark:text-zinc-400">หมวดที่ได้ &lt; 60%</span></h2>
        <ul data-weak class="mt-3 space-y-1.5 text-sm"></ul>
      </section>
    </div>

    <WeaknessChart id="result-chart" title="ผลแยกตามหมวด" description="เส้นแนวตั้งในแต่ละแท่ง = เกณฑ์ 60% และ 80%" />

    <div class="flex flex-col gap-3 sm:flex-row">
      <a id="btn-review" href="/review/" class="btn-primary flex-1 py-3">ทบทวนข้อที่ผิด</a>
      <a id="btn-retake" href="/exam/" class="btn-secondary flex-1 py-3">ทำใหม่อีกครั้ง</a>
      <a href="/history/" class="btn-ghost py-3">ดูประวัติ</a>
    </div>
  </div>
</BaseLayout>

<script>
  import { getAttempt } from '../lib/storage.js';
  import { MODE_LABELS } from '../lib/analytics.js';
  import { formatDuration } from '../lib/timer.js';
  import { renderCategoryBars, escapeHtml, formatDate, CATEGORY_BY_NAME } from '../lib/ui.js';

  const id = new URLSearchParams(location.search).get('id');
  const a = getAttempt(id);

  if (!a) {
    document.getElementById('empty')!.hidden = false;
  } else {
    const root = document.getElementById('content')!;
    root.hidden = false;
    const q = <T extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as T;

    q('[data-auto]').hidden = !a.autoSubmitted;
    q('[data-percent]').textContent = `${a.percent}%`;
    const ring = q<SVGCircleElement>('[data-ring]');
    const circ = Number(ring.dataset.circ);
    ring.dataset.passed = String(a.passed);
    requestAnimationFrame(() => ring.setAttribute('stroke-dashoffset', String(circ * (1 - a.percent / 100))));

    const badge = q('[data-pass-badge]');
    badge.dataset.passed = String(a.passed);
    badge.textContent = a.passed ? 'ผ่าน' : 'ไม่ผ่าน';
    q('[data-meta]').textContent = `${MODE_LABELS[a.mode as keyof typeof MODE_LABELS] ?? a.mode} · ${a.label ?? ''} · ${formatDate(a.date)}`;
    q('[data-grade]').textContent = a.grade;
    q('[data-raw]').textContent = `${a.correct}/${a.total}`;
    q('[data-duration]').textContent = formatDuration(a.durationSec ?? 0);

    const list = (names: string[], empty: string) =>
      names.length
        ? names
            .map((n) => {
              const c = a.byCategory[n];
              return `<li class="flex justify-between gap-3"><span><span class="font-medium">${escapeHtml(n)}</span> <span class="text-zinc-500 dark:text-zinc-400">${escapeHtml(CATEGORY_BY_NAME.get(n)?.nameTh ?? '')}</span></span><span class="shrink-0 tabular-nums">${c.percent}%</span></li>`;
            })
            .join('')
        : `<li class="text-zinc-500 dark:text-zinc-400">${empty}</li>`;
    q('[data-strong]').innerHTML = list(a.strong, 'ยังไม่มีหมวดที่ถึง 80%');
    q('[data-weak]').innerHTML = list(a.weak, 'ไม่มีหมวดที่ต่ำกว่า 60% เยี่ยม!');

    renderCategoryBars(q('[data-weakness-chart="result-chart"]'), a.byCategory);

    const wrong = a.total - a.correct;
    const review = q<HTMLAnchorElement>('#btn-review');
    review.href = `/review/?id=${encodeURIComponent(a.id)}`;
    review.textContent = wrong ? `ทบทวนข้อที่ผิด (${wrong})` : 'ไม่มีข้อผิด';
    if (!wrong) review.setAttribute('aria-disabled', 'true'), review.classList.add('pointer-events-none', 'opacity-40');
    q<HTMLAnchorElement>('#btn-retake').href = a.retake ?? '/exam/';
  }
</script>
