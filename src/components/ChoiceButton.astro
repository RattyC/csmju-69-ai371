---
/**
 * ปุ่มตัวเลือก 1 ปุ่ม — ข้อความถูกเติมโดย client script (lib/ui.js → renderQuestion)
 * สถานะแสดงผลผ่าน data-state: idle | selected | correct | wrong | dim
 */
interface Props {
  index: number;
}
const { index } = Astro.props;
const letter = ['ก', 'ข', 'ค', 'ง', 'จ', 'ฉ'][index];
---

<button
  type="button"
  data-choice={index}
  data-state="idle"
  aria-pressed="false"
  class="group flex w-full items-start gap-3 rounded-xl border border-zinc-200 bg-white px-4 py-3.5 text-left text-[15px] leading-relaxed transition-[background-color,border-color,opacity] duration-200 hover:border-zinc-400 hover:bg-zinc-50
    data-[state=selected]:border-indigo-600 data-[state=selected]:bg-indigo-50 data-[state=selected]:ring-1 data-[state=selected]:ring-indigo-600
    data-[state=correct]:border-emerald-600 data-[state=correct]:bg-emerald-50 data-[state=correct]:ring-1 data-[state=correct]:ring-emerald-600
    data-[state=wrong]:border-rose-600 data-[state=wrong]:bg-rose-50 data-[state=wrong]:ring-1 data-[state=wrong]:ring-rose-600
    data-[state=dim]:opacity-55 aria-disabled:cursor-default aria-disabled:hover:bg-white
    dark:border-zinc-700 dark:bg-zinc-900 dark:hover:border-zinc-500 dark:hover:bg-zinc-800/60
    dark:data-[state=selected]:border-indigo-400 dark:data-[state=selected]:bg-indigo-950/60 dark:data-[state=selected]:ring-indigo-400
    dark:data-[state=correct]:border-emerald-500 dark:data-[state=correct]:bg-emerald-950/50 dark:data-[state=correct]:ring-emerald-500
    dark:data-[state=wrong]:border-rose-500 dark:data-[state=wrong]:bg-rose-950/50 dark:data-[state=wrong]:ring-rose-500
    dark:aria-disabled:hover:bg-zinc-900"
>
  <span
    aria-hidden="true"
    class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-lg border border-zinc-300 text-sm font-semibold text-zinc-600 transition-colors duration-200
      group-data-[state=selected]:border-indigo-600 group-data-[state=selected]:bg-indigo-600 group-data-[state=selected]:text-white
      group-data-[state=correct]:border-emerald-600 group-data-[state=correct]:bg-emerald-600 group-data-[state=correct]:text-white
      group-data-[state=wrong]:border-rose-600 group-data-[state=wrong]:bg-rose-600 group-data-[state=wrong]:text-white
      dark:border-zinc-600 dark:text-zinc-300"
  >
    {letter}
  </span>
  <span class="min-w-0 flex-1 pt-0.5">
    <span class="sr-only">ตัวเลือก {letter}: </span>
    <span data-choice-text></span>
    <span data-choice-sr class="sr-only"></span>
  </span>
  <kbd aria-hidden="true" class="mt-1 hidden shrink-0 sm:inline">{index + 1}</kbd>
</button>
